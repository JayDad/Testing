# ===========================================================================
# PIMS REST API 인증 설정
# ---------------------------------------------------------------------------
# 이 파일을 복사해서 `.env` 로 만들고 실제 값을 채우세요.
#   cp .env.example .env
# `.env` 는 .gitignore 에 포함되어 git 에 커밋되지 않습니다.
# ===========================================================================

# API 기본 주소 (보통 그대로 두면 됩니다)
PIMS_BASE_URL=https://gate-api.pimshosting.com

# 인증 방식 선택: basic | bearer | apikey | none
# PIMS 발급처에서 안내받은 방식으로 설정하세요.
PIMS_AUTH_SCHEME=basic

# ===========================================================================
# (기본) basic 방식 — Authorization: Basic base64(username:password)
#   ↓ 발급받은 아이디/비밀번호로 바꾸세요.
# ===========================================================================
PIMS_USERNAME=PUT_YOUR_USERNAME_HERE
PIMS_PASSWORD=PUT_YOUR_PASSWORD_HERE

# ===========================================================================
# (선택) bearer 방식 — Authorization: Bearer <토큰>
#   PIMS_AUTH_SCHEME=bearer 로 바꿨을 때만 사용됩니다.
# ===========================================================================
PIMS_API_TOKEN=PUT_YOUR_TOKEN_HERE

# ===========================================================================
# (선택) apikey 방식 — <헤더명>: <키>
#   헤더명은 발급처 기준으로 맞추세요 (예: x-api-key, apikey, X-PIMS-KEY ...)
# ===========================================================================
PIMS_API_KEY=PUT_YOUR_API_KEY_HERE
PIMS_API_KEY_HEADER=x-api-key

# ===========================================================================
# 네트워크 설정 (사내망/프록시 환경일 때)
# ===========================================================================
# 응답 대기 시간(초). 서버가 느리면 늘리세요. 기본 60.
PIMS_TIMEOUT=60

# 사내 프록시를 거쳐야 외부로 나가는 경우 프록시 주소를 넣으세요.
#   예) http://proxy.hhi.co.kr:8080  또는  http://user:pass@proxy:8080
# (비워두면 프록시 미사용. 시스템 HTTPS_PROXY 환경변수도 자동 인식됩니다.)
# PIMS_PROXY=http://proxy.company.com:8080

# 사내 프록시가 자체 SSL 인증서를 쓰는 경우 검증을 끌 수 있습니다(임시 우회용).
# PIMS_VERIFY_SSL=false
